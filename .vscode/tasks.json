{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Backend",
      "type": "shell",
      "command": "uv run uvicorn main:app --reload --port 8765",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "panel": "dedicated", "reveal": "always", "group": "dev" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: Frontend",
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "reveal": "always", "group": "dev" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: Both",
      "dependsOn": ["Dev: Backend", "Dev: Frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "shared", "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "Store: Add store (edit & run)",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:8765/api/stores/ -H 'Content-Type: application/json' -d '{\"id\":\"my-store\",\"name\":\"My Store\",\"type\":\"shopify\",\"base_url\":\"https://example.com\",\"collection_path\":\"/collections/board-games\"}' | python3 -m json.tool",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Store: Sync all",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:8765/api/stores/sync-all | python3 -m json.tool",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Health check",
      "type": "shell",
      "command": "curl -s http://localhost:8765/api/health | python3 -m json.tool",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Install deps",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Install deps",
      "type": "shell",
      "command": "bun install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Build",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Release: Bump Patch",
      "type": "shell",
      "command": "bash scripts/bump-version.sh patch",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Release: Bump Minor",
      "type": "shell",
      "command": "bash scripts/bump-version.sh minor",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Release: Bump Major",
      "type": "shell",
      "command": "bash scripts/bump-version.sh major",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Pre-release: Bump Minor",
      "type": "shell",
      "command": "bash scripts/bump-version.sh minor ${input:preReleaseSuffix}",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Pre-release: Bump Major",
      "type": "shell",
      "command": "bash scripts/bump-version.sh major ${input:preReleaseSuffix}",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "preReleaseSuffix",
      "type": "pickString",
      "description": "Pre-release suffix (appended to version, e.g. 0.2.0rc1)",
      "options": ["rc1", "rc2", "alpha1", "alpha2", "beta1", "beta2"],
      "default": "rc1"
    }
  ]
}
