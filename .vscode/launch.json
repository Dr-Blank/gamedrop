{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Debug (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--port", "8765"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "justMyCode": true,
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    }
  ]
}
