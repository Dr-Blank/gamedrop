# BGG API token — required as of Oct 2025
# Register (must be logged in): https://boardgamegeek.com/using_the_xml_api
BGG_API_TOKEN=your_token_here

# ntfy — self-hosted push notifications
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=gamedrop
# NTFY_TOKEN=your_access_token   # only if ntfy requires auth

# Data directory for SQLite DB (default: backend/data/ for local, /data in Docker)
# DATA_DIR=/data
